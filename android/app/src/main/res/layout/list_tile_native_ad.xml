<?xml version="1.0" encoding="utf-8"?>
<!--
  Native ad template styled to match StockNewsCard / StockListItem
  (see lib/features/news/widgets/stock_news_card.dart and
  lib/core/theme/app_colors.dart) so ads blend into the app's feeds
  instead of looking like a bolted-on banner.
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/native_ad_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- "Ad" attribution badge, required by AdMob policy -->
        <TextView
            android:id="@+id/ad_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ad"
            android:textAllCaps="true"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#5D7290"
            android:background="@drawable/native_ad_badge_background"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginBottom="8dp"/>

        <!--
          Full-width, fixed-height block so AdMob always has a real
          surface to render video/large-image creative into. Height must
          be generous enough for video playback — a cramped MediaView
          (e.g. sized like the small icon below) triggers AdMob's
          "MediaView is too small for video" warning. Hidden entirely
          when the loaded ad has no media content (see
          ListTileNativeAdFactory.kt), in which case only the icon row
          below is shown.
        -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ad_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/ad_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#E6EDF7"/>

                <TextView
                    android:id="@+id/ad_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textSize="11sp"
                    android:textColor="#5D7290"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/ad_advertiser"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="10sp"
                        android:textColor="#5D7290"/>

                    <RatingBar
                        android:id="@+id/ad_stars"
                        style="?android:attr/ratingBarStyleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="14dp"
                        android:isIndicator="true"
                        android:numStars="5"
                        android:stepSize="0.1"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/ad_cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="36dp"
            android:paddingVertical="8dp"
            android:background="@drawable/native_ad_cta_background"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#F5A623"/>
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
